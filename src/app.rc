// Executable resources: icon, manifest (visual styles, DPI awareness, UTF-8 code page), version.
#include <winver.h>

1 ICON "../assets/app.ico"
1 24 "../assets/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Vibefinity Blade 3 contributors"
            VALUE "FileDescription", "Vibefinity Blade 3 - Infinity Blade III for PC"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "VibefinityBlade3"
            VALUE "LegalCopyright", "MIT License. Infinity Blade III is (c) Chair Entertainment / Epic Games."
            VALUE "OriginalFilename", "Vibefinity Blade 3.exe"
            VALUE "ProductName", "Vibefinity Blade 3"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
