// Executable resources: icon, manifest (visual styles, DPI awareness, UTF-8 code page), version.
#include <winver.h>

1 ICON "../assets/app.ico"
1 24 "../assets/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IB3 PC Port contributors"
            VALUE "FileDescription", "IB3 PC Port"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "IB3"
            VALUE "LegalCopyright", "MIT License. IB3 is (c) Chair Entertainment / Epic Games."
            VALUE "OriginalFilename", "IB3.exe"
            VALUE "ProductName", "IB3 PC Port"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
