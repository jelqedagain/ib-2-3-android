<?xml version="1.0" encoding="utf-8"?>
<!-- Infinity Blade III PC Port, Android build: a NativeActivity running libib3.so (no Java code). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ib3port.game"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Infinity Blade III"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:appCategory="game"
        android:allowBackup="false">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="ib3" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
